rules_version = '2';
// Firestore security rules for the RSJJYC membership platform.
// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // a renewal may push expiry at most ~14 months ahead of today
    function renewalOk() { return !('expiryMs' in request.resource.data) || request.resource.data.expiryMs <= request.time.toMillis() + 430 * 86400000; }
    // An admin may change member details ONLY to apply a member's own change request,
    // in the same write that approves it, and only the fields that request asked for.
    function crPath(id) { return /databases/$(database)/documents/changeRequests/$(id); }
    function appliesApprovedRequest(memberUid) {
      return isAdmin()
        && request.resource.data.get('lastChangeRequest', '') != ''
        && approvedNow(request.resource.data.lastChangeRequest, memberUid);
    }
    function approvedNow(id, memberUid) {
      return get(crPath(id)).data.status == 'pending'
        && getAfter(crPath(id)).data.status == 'approved'
        && getAfter(crPath(id)).data.uid == memberUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(getAfter(crPath(id)).data.changes.keys().concat(['lastChangeRequest']));
    }

    // admins/{uid} documents are created by hand in the Firebase console
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // One person = one membership: each phone / e-mail can be claimed only once.
    // (A key can never be overwritten or removed through the website.)
    match /uniques/{key} {
      allow get: if signedIn();
      allow list: if isAdmin();
      // members claim their own; an admin claims / releases them only when applying an approved change request
      allow create: if signedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
      allow delete: if isAdmin();
    }

    // membership-number sequence per year (can only ever go up by one)
    match /counters/{year} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.count == 1;
      allow update: if signedIn() && request.resource.data.count == resource.data.count + 1;
    }

    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.memberType == 'General Member'
        && request.resource.data.paidThrough == null;
      // Admins may NOT edit member details or delete members. They can only set the
      // member type, the paid-through month and the active / inactive flag.
      allow update: if (isAdmin() && onlyKeys(['memberType', 'paidThrough', 'inactive']))
        || appliesApprovedRequest(uid)
        || (signedIn() && request.auth.uid == uid && onlyKeys(['expiryMs', 'periods', 'renewals', 'paidThrough']) && renewalOk());
      allow delete: if false;
    }

    // Public QR card: anyone with the (unguessable) token can read ONE card; nobody can list them.
    match /publicCards/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.memberType == 'General Member'
        && request.resource.data.paidThrough == null;
      allow update: if (isAdmin() && onlyKeys(['memberType', 'paidThrough', 'inactive']))
        || appliesApprovedRequest(resource.data.uid)
        || (signedIn() && resource.data.uid == request.auth.uid && onlyKeys(['expiryMs', 'periods', 'paidThrough']) && renewalOk());
      allow delete: if false;
    }

    // Member detail change requests: the member asks, the admin approves or rejects.
    match /changeRequests/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && onlyKeys(['status', 'reviewedAt', 'reviewedBy', 'adminReason']);
      allow delete: if false;
    }

    // A payment counts as paid only when a receipt is uploaded in the same write.
    // Admins only record their decision (approve / reject); payments are never deleted.
    match /payments/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'approved'
                && request.resource.data.reviewed == false
                && existsAfter(/databases/$(database)/documents/receipts/$(id))));
      allow update: if isAdmin() && onlyKeys(['status', 'reviewed', 'reviewedAt', 'reviewedBy', 'adminNote']);
      allow delete: if false;
    }

    match /receipts/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /waivers/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isAdmin() && onlyKeys(['status', 'reviewedAt', 'reviewedBy', 'adminReason']);
      allow delete: if false;
    }
  }
}
